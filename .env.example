# ---------------------------------------------------------------------------
# TeenBuddy environment. Copy to .env.local (web) / .env (services). Never commit.
# The app runs fully WITHOUT any of these using the local in-browser adapter.
# ---------------------------------------------------------------------------

# --- Firebase (apps/web). Absent => app falls back to the local adapter. -----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the web app at the local Firebase emulator suite instead of prod.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=

# --- services/llm ------------------------------------------------------------
# Path to the local Claude Code binary. Resolved from PATH when unset.
TEENBUDDY_CLAUDE_BIN=
# Provider id: "claude-code" (default) | "stub" (deterministic, for tests)
TEENBUDDY_LLM_PROVIDER=
# Per-request wall-clock budget, milliseconds.
TEENBUDDY_LLM_TIMEOUT_MS=45000
